<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.banny.lotsonote.mapper.QuestionSolutionMapper">

    <resultMap id="BaseResultMap" type="com.banny.lotsonote.model.entity.QuestionSolution">
        <id column="solution_id" property="solutionId"/>
        <result column="question_id" property="questionId"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findByQuestionId" resultMap="BaseResultMap">
        SELECT *
        FROM question_solution
        WHERE question_id = #{questionId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="solutionId">
        INSERT INTO question_solution (question_id, content)
        VALUES (#{questionId}, #{content})
    </insert>

    <update id="updateByQuestionId">
        UPDATE question_solution
        SET content = #{content},
            updated_at = CURRENT_TIMESTAMP
        WHERE question_id = #{questionId}
    </update>

    <delete id="deleteByQuestionId">
        DELETE
        FROM question_solution
        WHERE question_id = #{questionId}
    </delete>
</mapper>
