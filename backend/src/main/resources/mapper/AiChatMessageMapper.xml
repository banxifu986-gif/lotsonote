<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.banny.lotsonote.mapper.AiChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.banny.lotsonote.model.entity.AiChatMessage">
        <id column="message_id" property="messageId"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findBySessionId" resultMap="BaseResultMap">
        SELECT *
        FROM ai_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY message_id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="messageId">
        INSERT INTO ai_chat_message (session_id, role, content)
        VALUES (#{sessionId}, #{role}, #{content})
    </insert>
</mapper>
