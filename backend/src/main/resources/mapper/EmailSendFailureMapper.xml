<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.banny.lotsonote.mapper.EmailSendFailureMapper">
    <resultMap id="BaseResultMap" type="com.banny.lotsonote.model.entity.EmailSendFailure">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="email" property="email"/>
        <result column="type" property="type"/>
        <result column="retry_count" property="retryCount"/>
        <result column="reason" property="reason"/>
        <result column="created_at" property="createdAt"/>
        <result column="failed_at" property="failedAt"/>
        <result column="trace_id" property="traceId"/>
        <result column="expired_flag" property="expiredFlag"/>
    </resultMap>

    <insert id="insert" parameterType="com.banny.lotsonote.model.entity.EmailSendFailure" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO email_send_failure (
            task_id,
            email,
            type,
            retry_count,
            reason,
            created_at,
            failed_at,
            trace_id,
            expired_flag
        )
        VALUES (
            #{taskId},
            #{email},
            #{type},
            #{retryCount},
            #{reason},
            #{createdAt},
            #{failedAt},
            #{traceId},
            #{expiredFlag}
        )
        ON DUPLICATE KEY UPDATE
            retry_count = VALUES(retry_count),
            reason = VALUES(reason),
            failed_at = VALUES(failed_at),
            trace_id = VALUES(trace_id),
            expired_flag = VALUES(expired_flag)
    </insert>
</mapper>
